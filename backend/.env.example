# ─────────────────────────────────────────────────────
# TradeX backend environment template
# Copy to `.env` and fill in. Commit .env.example, NEVER .env
# ─────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────
ENVIRONMENT=dev            # dev | staging | prod
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
PAPER_TRADING=true

# ── Security ─────────────────────────────────────────
# 32-byte AES-256 key as hex (64 chars).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────
# Comma-separated. Must NOT contain '*' in prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=              # anon/public key
SUPABASE_SERVICE_KEY=      # service-role key (server-only, bypasses RLS)

# ── Upstash Redis (REST) ─────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate limits (per minute) ─────────────────────────
USER_RATE_LIMIT_PER_MIN=120
ADMIN_RATE_LIMIT_PER_MIN=30
SCAN_RATE_LIMIT_PER_MIN=5
JWT_CACHE_TTL_SECONDS=60

# ── LLMs ─────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DAILY_LLM_BUDGET_INR=50

# ── Notifications ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Brokers (platform defaults — users set their own in-app) ──
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=

DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_TESTNET_URL=https://testnet-api.delta.exchange

# ── Supplementary data ───────────────────────────────
COINGLASS_API_KEY=
CRYPTOPANIC_API_KEY=

# ── Platform defaults ────────────────────────────────
TOTAL_CAPITAL_INR=200000
MAX_POSITION_PCT=10
MAX_CRYPTO_PCT=30
