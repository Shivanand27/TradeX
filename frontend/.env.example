# Copy to `.env.local` and fill in. Do NOT commit `.env.local`.
# Every VITE_* variable is bundled into the client — no secrets!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# In dev, leave these unset — the Vite proxy handles /api and /ws.
# In prod, point them at your deployed backend, e.g.:
#   VITE_API_URL=https://api.tradex.app
#   VITE_WS_HOST=api.tradex.app
VITE_API_URL=
VITE_WS_HOST=
